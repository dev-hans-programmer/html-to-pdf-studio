{
  "name": "html-pdf-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop tool for formatting HTML and exporting print-ready PDFs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "convert": "electron . --convert",
    "package:mac": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hasanali.htmltopdfstudio",
    "productName": "HTML to PDF Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "README.md"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "assets/app-icon.icns",
      "category": "public.app-category.productivity",
      "identity": null
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
